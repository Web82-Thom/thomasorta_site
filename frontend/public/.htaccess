<IfModule mod_rewrite.c>
    RewriteEngine On

    # Keep API calls out of the React router. They are handled by Symfony.
    RewriteRule ^api(/.*)?$ - [L]

    # Serve existing static files and directories directly.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Let React Router handle public pages on browser refresh.
    RewriteRule ^ index.html [L]
</IfModule>
